# Ask the organizer for the endpoint and a READ-ONLY key for this collection.
# Keep this file local as .env; never commit actual credentials.
QDRANT_URL=https://YOUR-CLUSTER-ENDPOINT:6333
QDRANT_API_KEY=YOUR-READ-ONLY-DATABASE-KEY
QDRANT_COLLECTION=fix_the_search_v2

# Hands-on retrieval needs no large local model or hosted-model credentials.
# The facilitator demonstrates the live planner and generated brief.
ANSWER_PROVIDER=evidence
FASTEMBED_OFFLINE=1
APP_PORT=8000

# Optional: use your own model for a live agent on your laptop.
# ANSWER_PROVIDER=ollama
# ANSWER_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
