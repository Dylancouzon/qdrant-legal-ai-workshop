# Organizer configuration. These defaults require no credentials.
QDRANT_URL=http://127.0.0.1:6333
# Optional, server-side only, if the organizer uses a protected Qdrant instance:
# QDRANT_API_KEY=
QDRANT_COLLECTION=fix_the_search_v2
# Defaults to .workshop/models inside this repository:
# FASTEMBED_CACHE_PATH=/absolute/path/to/prepared/models
# Runtime uses cached files only. The prepare command enables model downloads.
FASTEMBED_OFFLINE=1
APP_HOST=127.0.0.1
APP_PORT=8000

# Live local agent: organizer installs Ollama and prepares this model once.
ANSWER_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANSWER_MODEL=qwen3:8b
MODEL_TIMEOUT=120
# Qwen3 reasoning is used internally for the brief, never displayed as a trace.
MODEL_THINK=1
# Explicit no-model fallback: ANSWER_PROVIDER=evidence
# Optional hosted provider: ANSWER_PROVIDER=openai, with an organizer-chosen model.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
